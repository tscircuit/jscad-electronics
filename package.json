{
  "name": "jscad-electronics",
  "type": "module",
  "version": "0.0.241",
  "main": "./dist/index.js",
  "exports": {
    ".": {
      "import": "./dist/index.js"
    },
    "./vanilla": {
      "import": "./dist/vanilla.js"
    },
    "./cables": {
      "import": "./dist/cables.js",
      "types": "./dist/cables.d.ts"
    }
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/tscircuit/jscad-electronics"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "generate": "node scripts/generate-model-renderers.mjs",
    "generate:watch": "node scripts/watch-model-renderers.mjs",
    "contracts:prepare": "node scripts/prepare-model-contracts.mjs",
    "contracts:refresh": "node scripts/prepare-model-contracts.mjs --refresh",
    "start": "node scripts/run-model-dev.mjs",
    "dev": "node scripts/run-model-dev.mjs",
    "build": "tsup --config tsup.config.ts",
    "vercel-build": "bun run build:site",
    "typecheck": "node scripts/prepare-model-contracts.mjs && node scripts/generate-model-renderers.mjs && tsc --noEmit",
    "format": "node scripts/generate-model-renderers.mjs && biome format --write .",
    "format:check": "node scripts/generate-model-renderers.mjs && biome format .",
    "build:site": "node scripts/prepare-model-contracts.mjs && node scripts/generate-model-renderers.mjs && cosmos-export",
    "postinstall": "node scripts/prepare-model-contracts.mjs --refresh",
    "prepare": "npm run build",
    "prepack": "npm run build",
    "test:vanilla": "bun run build && node tests/vanilla-smoke.mjs",
    "test": "bun test"
  },
  "dependencies": {
    "@tscircuit/mm": "^0.0.8",
    "earcut": "^3.2.3",
    "jscad-fiber": "^0.0.92",
    "zod": "^3.25.67",
    "@tscircuit/jscad": "https://jscdn.tscircuit.com/@tscircuit/jscad/0.0.3.tgz"
  },
  "devDependencies": {
    "@tscircuit/circuit-json-to-drawing": "https://github.com/tscircuit/circuit-json-to-drawing/archive/a0e146576bae2aebd38fb1af6662b3ad44eaa89a.tar.gz",
    "@tscircuit/modelprinter": "latest",
    "@biomejs/biome": "^1.9.3",
    "@tscircuit/alphabet": "^0.0.24",
    "@tscircuit/footprinter": "^0.0.431",
    "@types/earcut": "^3.0.0",
    "@types/pngjs": "^6.0.5",
    "@types/react": "19",
    "@types/react-dom": "19",
    "@types/three": "^0.179.0",
    "bun-types": "^1.2.20",
    "bun-match-svg": "^0.0.17",
    "gl-matrix": "^3.4.4",
    "jscad-to-gltf": "^0.0.9",
    "looks-same": "^10.0.1",
    "pngjs": "^7.0.0",
    "poppygl": "^0.0.37",
    "react-cosmos": "7.0.0",
    "react-cosmos-plugin-vite": "7.0.0",
    "tsup": "^8.3.0",
    "vite": "^7.1.2",
    "vite-tsconfig-paths": "^5.0.1",
    "circuit-json": "^0.0.534"
  },
  "peerDependencies": {
    "@jscad/modeling": "^2.12.5",
    "@tscircuit/footprinter": "*",
    "@tscircuit/alphabet": "^0.0.24",
    "circuit-json": "^0.0.426",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "three": "^0.179.1"
  },
  "engines": {
    "node": "24.x"
  },
  "trustedDependencies": [
    "esbuild",
    "sharp"
  ]
}
